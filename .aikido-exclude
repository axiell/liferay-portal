# Arena Liferay Portal 7.4.3.129-ga129-specific Aikido scan excludes.
# One glob pattern per line (# comments allowed), passed as --exclude to
# .claude/skills/aikido-scan/scripts/aikido-scan.sh.
# Kept here (repo root) rather than in the aikido-scan skill so the skill
# itself stays portable to other projects unmodified.

# IDE-generated build/compiled-class output for the Ant-built core modules
# (portal-impl, portal-kernel, portal-test, portal-test-integration,
# support-tomcat, util-bridges, util-java, util-slf4j, util-taglib, ...).
# This repo's own .gitignore predates these paths (it lists per-module
# classes/test-classes/woven-classes, not build/) so they show up untracked.
# Verified via `git ls-files | grep -E "(^|/)build/"` — zero tracked files
# live under any build/ directory anywhere in this repo, so this is safe.
**/build/**

# Stray JVM heap dump left in the working tree (modules/apps/foundation/
# portal/java_pid83209.hprof) — not build output, but pure scan noise either
# way. Consider deleting it directly; it may contain sensitive memory
# contents and has no reason to exist in the working tree.
**/*.hprof

# NOTE: node_modules (~267 directories under modules/**) is intentionally
# NOT excluded here. Aikido's JS supply-chain coverage (package-lock.json /
# node_modules CVEs) is real scanning surface, not noise — unlike the
# palma-style scope exclusions elsewhere, this is a security-coverage
# decision, not cleanup. If scan time/volume becomes a problem, discuss
# before adding an exclude for it.
# NOTE: "scripts" and "readme" are deliberately NOT in this list, even
# though they match the same stock-reference-noise pattern as the rest.
# scripts/ now also holds this branch's own release tooling
# (scripts/deploy-maven-artifacts.sh) — excluding the bare name would
# silently hide that from scanning. "readme" is a
# generic enough name to risk matching unintended paths depending on repo
# layout; narrow it to the actual guideline docs if it needs excluding.
# Root-only non-production trees. Written as `<name>/**` (with a slash) on
# purpose: a slash makes the pattern start-anchored and immune to minimatch's
# matchBase, so it excludes only the top-level dir's contents and never the
# same-named dirs nested under production modules (e.g. modules/**/sql,
# modules/**/gradle, modules/**/definitions). A bare `sql` would leak into
# those nested production paths if the scanner enables matchBase.
bin/**
benchmarks/**
definitions/**
learn-resources/**
gradle/**
sql/**
workspaces/**
portal-test/**
oss-licenses/**

# Test/integration-test source inside otherwise-in-scope production modules.
# None of it ships in the deploy-maven-artifacts.sh outputs (the osgi zip,
# portal-*.jar/war, util-*.jar) — it is not production surface. Trade-off:
# secrets or vulnerable test-scope deps living only under test sources will
# no longer be flagged; SCA on package-lock.json / pom test deps is
# unaffected since those manifests sit above src/. Anchored to src/ so main
# sources are untouched.
**/src/test/**
**/src/testIntegration/**
