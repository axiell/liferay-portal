#   benchmarks       2 / 8         sql              25 / 554
#   definitions    227 / 314       workspaces     5472 / 115
#   lib             20 / 25
# Enabling any line below also drops the nested production paths from the
# scan. That is a security-scope decision - decide per tree, do not bulk
# uncomment.
# /bin/
# /benchmarks/
# /definitions/
# /gradle/
# /sql/
# /workspaces/
# /lib/
